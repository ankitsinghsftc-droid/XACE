{
  "name": "@xace/builder-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev":       "vite",
    "build":     "tsc -p tsconfig.json --noEmit && vite build",
    "lint":      "tsc -p tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters",
    "preview":   "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:ui":   "node tools/builder_ui_contract_test.mjs",
    "test:server": "python -m unittest discover -s server/tests -p \"test*.py\"",
    "test":      "npm run lint && npm run typecheck && npm run test:ui && npm run test:server"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite":       "^5.2.0"
  }
}
