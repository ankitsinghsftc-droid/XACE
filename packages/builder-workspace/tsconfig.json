{
  "compilerOptions": {
    "target":                     "ES2022",
    "module":                     "ESNext",
    "moduleResolution":           "bundler",
    "lib":                        ["ES2022", "DOM", "DOM.Iterable"],
    "strict":                     true,
    "noUncheckedIndexedAccess":   true,
    "noImplicitOverride":         true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck":               true,
    "sourceMap":                  true,
    "rootDir":                    "src",
    "outDir":                     "dist",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "vite.config.ts", "tsconfig.node.json"]
}